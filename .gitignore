# Godot 4+ specific ignores
.godot/
/android/

# Exports — podem conter caminhos locais e credenciais de assinatura
export_presets.cfg
*.exe
*.pck
*.zip

# Configuração local do Claude Code (permissões desta máquina)
.claude/settings.local.json

# Windows
Thumbs.db
desktop.ini

# Artefato de build do Python. `import traduzir` a partir de um teste ou de
# uma sonda gera isto e sujava a árvore — foi apontado numa revalidação.
__pycache__/
*.pyc

# Folhas de contato do personagem: 5 MB de PNG que `renderizar_previa.py`
# refaz em vinte segundos. São para OLHAR, não para guardar.
arte/previa/

# Backup automático do Blender.
*.blend1

# O `.blend` do personagem NÃO é rastreado, e a razão é medida: exportá-lo duas
# vezes do mesmo código dá dois arquivos diferentes (o Blender grava estado que
# não vem da cena). Artefato que não se reproduz não pode ser conferido por
# reprodução, e rastreá-lo faz toda geração sujar a árvore. Ele nasce local, em
# dez segundos, com `tools/arte/gerar_personagem.py` — e o `.glb`, que é o que
# o jogo consome, ESSE é determinístico, rastreado e conferido.
arte/fonte/*.blend
.mutacao-em-curso
.mutacao-guardados/
